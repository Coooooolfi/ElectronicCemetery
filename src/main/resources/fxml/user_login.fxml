<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.electroniccemetery.controller.UserLoginController"
            prefWidth="650" prefHeight="700" maxWidth="650" maxHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="Назад" onAction="#onBackClick"/>
            <Label text="Вход пользователя" styleClass="title"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <TextField fx:id="loginField" promptText="Логин" prefWidth="250"/>
            <PasswordField fx:id="passwordField" promptText="Пароль" prefWidth="250"/>
            <Button text="Войти" onAction="#onLoginClick" prefWidth="120"/>
            <Label fx:id="errorLabel" textFill="red"/>

            <Hyperlink text="Нет аккаунта? Зарегистрироваться" onAction="#onRegisterClick"/>
        </VBox>
    </center>
</BorderPane>